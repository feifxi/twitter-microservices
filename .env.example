# Copy this file to .env and fill in your values.
# All services + Keycloak + the realm template read from this single file.

# === OpenAI — search-service text embeddings ===
# Get yours: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# === Google OAuth — Keycloak "Sign in with Google" identity provider ===
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/realms/twitter/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Postgres — shared by every service and by Keycloak ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=twitter

# === Keycloak admin console (http://localhost:8080) ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# === Service-to-service auth ===
# Bearer token used by internal routes (Kong-protected) and the Keycloak SPI.
SERVICE_TOKEN=dev-service-token

# Keycloak service-account client used by user-service to provision users.
# The same secret is baked into the realm template under clients[kong-admin].
KEYCLOAK_ADMIN_CLIENT_ID=kong-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=kong-admin-secret

# === AWS / LocalStack — media-service S3 uploads ===
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-southeast-1
